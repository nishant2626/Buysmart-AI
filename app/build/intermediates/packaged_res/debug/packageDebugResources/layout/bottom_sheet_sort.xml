<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_by"
        android:textAppearance="@style/TextAppearance.BuySmart.TitleLarge"
        android:textColor="@color/on_surface" />

    <RadioGroup
        android:id="@+id/rg_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rb_relevance"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Relevance" />

        <RadioButton
            android:id="@+id/rb_price_low"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/lowest_price" />

        <RadioButton
            android:id="@+id/rb_price_high"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/highest_price" />

        <RadioButton
            android:id="@+id/rb_rating"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/highest_rating" />

    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply_sort"
        style="@style/Widget.BuySmart.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/apply_filters" />

</LinearLayout>
