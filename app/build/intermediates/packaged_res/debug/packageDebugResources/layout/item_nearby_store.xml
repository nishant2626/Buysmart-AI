<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.BuySmart.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Store Image -->
        <ImageView
            android:id="@+id/iv_store_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_location" />

        <!-- Store Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_store_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Name"
                android:textAppearance="@style/TextAppearance.BuySmart.BodyMedium"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/tv_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="123 Main Street, City Center"
                android:textAppearance="@style/TextAppearance.BuySmart.BodySmall"
                android:textColor="@color/on_surface_variant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/accent" />

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.5"
                    android:textAppearance="@style/TextAppearance.BuySmart.LabelSmall"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="500 m"
                    android:textAppearance="@style/TextAppearance.BuySmart.LabelSmall"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_open_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/open_now"
                    android:textAppearance="@style/TextAppearance.BuySmart.LabelSmall"
                    android:textColor="@color/secondary" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_directions"
                    style="@style/Widget.BuySmart.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/directions"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_location"
                    app:iconGravity="textStart"
                    app:iconSize="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_call"
                    style="@style/Widget.BuySmart.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/call_store"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_notifications"
                    app:iconGravity="textStart"
                    app:iconSize="14dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
