<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.BuySmart.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Platform Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/view_platform_color"
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@color/primary" />

            <TextView
                android:id="@+id/tv_platform_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Amazon"
                android:textAppearance="@style/TextAppearance.BuySmart.TitleMedium"
                android:textColor="@color/on_surface" />

            <!-- Badges -->
            <TextView
                android:id="@+id/tv_best_price_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_recommendation_buy"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/best_price"
                android:textAppearance="@style/TextAppearance.BuySmart.LabelSmall"
                android:textColor="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_fastest_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_recommendation_likely"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/fastest_delivery"
                android:textAppearance="@style/TextAppearance.BuySmart.LabelSmall"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Price Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹24,999"
                android:textAppearance="@style/TextAppearance.BuySmart.TitleLarge"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_original_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="₹29,999"
                android:textAppearance="@style/TextAppearance.BuySmart.BodyMedium"
                android:textColor="@color/on_surface_variant"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_discount_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="17% OFF"
                android:textAppearance="@style/TextAppearance.BuySmart.LabelSmall"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Delivery & Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tv_delivery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="2 Days"
                    android:textAppearance="@style/TextAppearance.BuySmart.BodySmall"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/accent" />

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.5"
                    android:textAppearance="@style/TextAppearance.BuySmart.BodySmall"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Seller Info -->
        <TextView
            android:id="@+id/tv_seller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sold by: Official Store"
            android:textAppearance="@style/TextAppearance.BuySmart.BodySmall"
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:id="@+id/tv_official_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_platform_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/official_store"
            android:textAppearance="@style/TextAppearance.BuySmart.LabelSmall"
            android:textColor="@color/secondary"
            android:visibility="gone" />

        <!-- Stock Status -->
        <TextView
            android:id="@+id/tv_stock_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/in_stock"
            android:textAppearance="@style/TextAppearance.BuySmart.BodySmall"
            android:textColor="@color/secondary" />

        <!-- Buy Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_buy"
            style="@style/Widget.BuySmart.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/buy_now" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
