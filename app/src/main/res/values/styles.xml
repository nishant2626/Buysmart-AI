<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Premium Typography Hierarchy -->
    <style name="TextAppearance.BuySmart.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.BuySmart.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/charcoal</item>
    </style>
    <style name="TextAppearance.BuySmart.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/charcoal</item>
    </style>

    <style name="TextAppearance.BuySmart.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.BuySmart.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/charcoal</item>
    </style>
    <style name="TextAppearance.BuySmart.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/charcoal</item>
    </style>

    <style name="TextAppearance.BuySmart.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.BuySmart.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/charcoal</item>
    </style>
    <style name="TextAppearance.BuySmart.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/charcoal</item>
    </style>

    <style name="TextAppearance.BuySmart.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.BuySmart.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="TextAppearance.BuySmart.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.BuySmart.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.BuySmart.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="TextAppearance.BuySmart.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Shape System -->
    <style name="ShapeAppearance.BuySmart.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.BuySmart.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.BuySmart.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Component Styles -->
    <style name="Widget.BuySmart.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.BuySmart.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>

    <style name="Widget.BuySmart.BentoCard" parent="Widget.BuySmart.CardView">
        <item name="cardBackgroundColor">@color/soft_gray</item>
        <item name="cardElevation">0dp</item>
        <item name="android:stateListAnimator">@animator/lift_on_touch</item>
    </style>

    <style name="Widget.BuySmart.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BuySmart.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BuySmart.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Widget.BuySmart.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Widget.BuySmart.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="Widget.BuySmart.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextColor">@color/on_surface_variant</item>
        <item name="tabSelectedTextColor">@color/accent</item>
        <item name="tabIndicatorColor">@color/accent</item>
    </style>

    <style name="Widget.BuySmart.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.BuySmart.TitleLarge</item>
        <item name="background">@color/surface</item>
    </style>

</resources>
