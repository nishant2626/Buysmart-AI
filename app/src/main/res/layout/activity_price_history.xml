<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_back"
        app:title="Price Intelligence"
        app:titleTextColor="@color/on_surface"
        app:elevation="4dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textAppearance="@style/TextAppearance.BuySmart.HeadlineSmall"
                android:textColor="@color/on_background"
                android:layout_marginBottom="16dp" />

            <!-- Price Statistics Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">

                <!-- Best of Month (Low) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BuySmart.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="@color/secondary_container">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Best (Month)"
                            android:textSize="10sp"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:textColor="@color/on_secondary_container" />
                        <TextView
                            android:id="@+id/tv_month_low"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textAppearance="@style/TextAppearance.BuySmart.TitleMedium"
                            android:textColor="@color/secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Month High -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BuySmart.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High (Month)"
                            android:textSize="10sp"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface_variant" />
                        <TextView
                            android:id="@+id/tv_month_high"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textAppearance="@style/TextAppearance.BuySmart.TitleMedium"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- All Time Low -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.BuySmart.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardBackgroundColor="@color/primary_container">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Time Low"
                            android:textSize="10sp"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:textColor="@color/on_primary_container" />
                        <TextView
                            android:id="@+id/tv_all_time_low"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textAppearance="@style/TextAppearance.BuySmart.TitleMedium"
                            android:textColor="@color/primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BuySmart.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30-Day Trend"
                        android:textAppearance="@style/TextAppearance.BuySmart.TitleMedium" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart_full_history"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_marginTop="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Detailed Price Log"
                android:textAppearance="@style/TextAppearance.BuySmart.TitleMedium" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_price_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
