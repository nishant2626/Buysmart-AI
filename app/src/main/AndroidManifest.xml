<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.buysmart.ai">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".BuySmartApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuySmartAI"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BuySmartAI.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Zero-Input Smart Scan -->
        <activity
            android:name=".activities.SmartScanActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Quick Delivery (SwiftDash) -->
        <activity
            android:name=".activities.QuickDeliveryActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Product Details -->
        <activity
            android:name=".activities.ProductDetailsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Price Comparison -->
        <activity
            android:name=".activities.PriceComparisonActivity"
            android:exported="false"
            android:parentActivityName=".activities.ProductDetailsActivity" />

        <!-- Price History -->
        <activity
            android:name=".activities.PriceHistoryActivity"
            android:exported="false"
            android:parentActivityName=".activities.ProductDetailsActivity" />

        <!-- Cart -->
        <activity
            android:name=".activities.CartActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Checkout -->
        <activity
            android:name=".activities.CheckoutActivity"
            android:exported="false"
            android:parentActivityName=".activities.CartActivity" />

        <!-- Orders -->
        <activity
            android:name=".activities.OrdersActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Nearby Stores -->
        <activity
            android:name=".activities.NearbyStoresActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Coupons -->
        <activity
            android:name=".activities.CouponsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Settings -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Edit Profile -->
        <activity
            android:name=".activities.EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Alerts -->
        <activity
            android:name=".activities.AlertsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Saved Products -->
        <activity
            android:name=".activities.SavedProductsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Legal and Support -->
        <activity
            android:name=".activities.LegalActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".services.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Price Alert Worker -->
        <service
            android:name=".services.PriceAlertService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Notification Channel -->
        <receiver
            android:name=".notifications.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
